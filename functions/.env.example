# Store production values with `firebase functions:secrets:set`, never in this file.
VERCEL_AI_GATEWAY_KEY=
OPENROUTER_API_KEY=
KILO_GATEWAY_API_KEY=
OPENCODE_API_KEY=

# Set in production with `firebase functions:secrets:set ADMIN_EMAILS`.
# Use comma-separated verified Firebase Auth emails. The `admin: true` custom
# claim is also accepted independently of this list.
ADMIN_EMAILS=
